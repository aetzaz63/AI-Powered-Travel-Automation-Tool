    {
      "parameters": {
        "description": "Use this tool to calculate the total trip cost. Provide a JSON object with: flightCost (number), hotelPerNight (number), nights (number), transfers (number), packagePrice (number), visaFee (number), serviceCharge (number), taxRate (number as percentage), travelers (number). Returns detailed cost breakdown with subtotal, taxes, and total. ALWAYS use this after getting pricing data.",
        "jsCode": "const input = $input.item.json;\nconst { flightCost = 0, hotelPerNight = 0, nights = 0, transfers = 0, packagePrice = 0, visaFee = 0, serviceCharge = 0, taxRate = 0, travelers = 1 } = input;\n\nconst hotelTotal = hotelPerNight * nights * travelers;\nconst flightTotal = flightCost * travelers;\nconst transfersTotal = transfers * travelers;\nconst packageTotal = packagePrice * travelers;\nconst visaTotal = visaFee * travelers;\nconst serviceTotal = serviceCharge * travelers;\n\nconst subtotal = flightTotal + hotelTotal + transfersTotal + packageTotal + visaTotal + serviceTotal;\nconst taxes = subtotal * (taxRate / 100);\nconst total = subtotal + taxes;\n\nreturn {\n  breakdown: {\n    flights: flightTotal,\n    hotels: hotelTotal,\n    transfers: transfersTotal,\n    package: packageTotal,\n    visa: visaTotal,\n    serviceCharge: serviceTotal,\n    subtotal: subtotal,\n    taxes: taxes,\n    total: total\n  },\n  travelers: travelers,\n  nights: nights\n};"
      },
