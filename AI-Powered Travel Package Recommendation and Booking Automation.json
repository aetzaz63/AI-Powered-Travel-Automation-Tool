    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Format each Google Sheets row into a comprehensive text for vector store\nconst item = $input.item.json;\n\n// Extract all fields from the row\nconst destination = item.Destination || '';\nconst overview = item.Overview || '';\nconst itinerary = item['Day-by-Day Itinerary'] || item.Itinerary || '';\nconst visaRequirements = item['Visa Requirements'] || item.Visa || '';\nconst hotels = item.Hotels || item.Accommodation || '';\nconst weather = item.Weather || item['Best Season'] || '';\nconst activities = item.Activities || item.Attractions || '';\n\n// Combine all information into a comprehensive searchable text\nconst text = `\nDESTINATION: ${destination}\n\nOVERVIEW:\n${overview}\n\nDAY-BY-DAY ITINERARY:\n${itinerary}\n\nVISA REQUIREMENTS:\n${visaRequirements}\n\nHOTELS & ACCOMMODATION:\n${hotels}\n\nWEATHER & BEST TIME TO VISIT:\n${weather}\n\nACTIVITIES & ATTRACTIONS:\n${activities}\n`.trim();\n\nreturn {\n  text: text,\n  metadata: {\n    destination: destination,\n    source: 'google_sheets'\n  }\n};"
      },
      "id": "5d5e883f-8de9-44df-8571-96a889dbeeb8",
      "name": "Format Travel Data for Vector Store",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1872,
        3120
      ]
    }
